def build_prompt(seed=None, theme=None, output_format="png", prompt_upsampling=True, safety_tolerance=3, explicit_color=None, explicit_creature=None, explicit_environment=None, raw=False, aspect_ratio="16:9"):
    if seed is not None:
        random.seed(seed)
    t = theme if theme in ("sci-fi", "fantasy") else random.choice(["sci-fi", "fantasy"])
    color = explicit_color if explicit_color else random.choice(colors)["name"]
    if t == "sci-fi":
        creatures = creatures_scifi
        environments = scifi_environments
        hero_weapon = "an energy katana"
        theme_tag = "pure SCI-FI anime scene"
    else:
        creatures = creatures_fantasy
        environments = fantasy_environments
        hero_weapon = "a sword/katana"
        theme_tag = "pure FANTASY anime scene"
    creature_key = explicit_creature if explicit_creature in creatures else random.choice(list(creatures.keys()))
    creature_desc = creatures[creature_key]
    environment = explicit_environment if explicit_environment in environments else random.choice(environments)

    base = (
        f"Epic {theme_tag} scene — bold, vibrant, and borderless with pure anime-first aesthetics. "
        f"Set in a richly detailed {environment}, filled with volumetric lighting, soft shadows, and cinematic fog for mood and scale. "
        f"A humanoid {creature_key} with {creature_desc}, accented by {color} highlights, stands prominently and faces both the hero and the camera. "
        f"The hero is an anime-style girl with long flowing hair tied in a ponytail with {color} tails, embodying a confident and determined presence. "
        f"Full-body shot — head to toe visible, clean edges, uncropped, no borders. "
        f"She faces the {creature_key} with her back to the camera, standing in a grounded combat-ready pose using a {hero_weapon}."
        f"Third-person perspective with a slightly low or dynamic angle to enhance scale and cinematic drama. "
        f"The composition must exude anime energy: crisp outlines, expressive shading, vivid color dominated by {color}, and cinematic intensity. "
        f"Strictly {t}-themed worldbuilding — no genre mixing. The image must be safe for work; the hero should not wear a bikini or revealing outfit. "
        f"Inspired by animes such as {inspirations}. "
        f"Use {color} as the dominant accent color throughout, subtly enhancing both the creature and environmental elements."
    )



    payload = {
        "prompt": base,
        "aspect_ratio": aspect_ratio,
        "prompt_upsampling": bool(prompt_upsampling),
        "safety_tolerance": int(safety_tolerance),
        "output_format": output_format,
        "raw": bool(raw)
    }
    picks = {"theme": t, "color": color, "creature": creature_key, "environment": environment}
    return base, payload, picks


def generate_image(bfl_api_key, payload):
    r = requests.post(
        "https://api.bfl.ai/v1/flux-pro-1.1-ultra",
        headers={"accept": "application/json", "x-key": bfl_api_key, "Content-Type": "application/json"},
        data=json.dumps(payload),
        timeout=60
    )
    r.raise_for_status()
    data = r.json()
    polling_url = data.get("polling_url")
    if not polling_url:
        raise RuntimeError("Missing polling_url")
    while True:
        time.sleep(0.5)
        pr = requests.get(polling_url, headers={"accept": "application/json", "x-key": bfl_api_key}, timeout=60)
        pr.raise_for_status()
        res = pr.json()
        status = res.get("status")
        if status == "Ready":
            return {"request_id": data.get("id"), "result_url": res.get("result", {}).get("sample"), "meta": res}
        if status in ("Error", "Failed"):
            raise RuntimeError(json.dumps(res))

def infer_extension_from_url(url, fallback="png"):
    path = urlparse(url).path.lower()
    if path.endswith(".png"):
        return "png"
    if path.endswith(".jpg") or path.endswith(".jpeg"):
        return "jpg"
    q = parse_qs(urlparse(url).query)
    if "format" in q:
        fmt = q["format"][0].lower()
        if fmt in ("png", "jpg", "jpeg"):
            return "png" if fmt == "jpeg" else fmt
    return fallback

def download_image(url, filename=None):
    ext = infer_extension_from_url(url)
    base_dir = "/env/set/.animegen"
    os.makedirs(base_dir, exist_ok=True)
    if filename is None:
        ts = datetime.utcnow().strftime("%Y%m%dT%H%M%SZ")
        filename = f"flux_ultra_{ts}.{ext}"
    if not os.path.isabs(filename):
        filepath = os.path.join(base_dir, filename)
    else:
        filepath = filename
    resp = requests.get(url, timeout=60)
    resp.raise_for_status()
    with open(filepath, "wb") as f:
        f.write(resp.content)
    return filepath


