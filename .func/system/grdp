#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 2 ]; then echo "Usage: $0 <RDP_USERNAME> <RDP_PASSWORD>"; exit 1; fi
RDP_USER="$1"
RDP_PASS="$2"

echo "[A] Preflight"
command -v grdctl >/dev/null 2>&1 || { echo "gnome-remote-desktop not installed"; exit 1; }
command -v pkttyagent >/dev/null 2>&1 || { echo "policykit-1 not installed"; exit 1; }
command -v openssl >/dev/null 2>&1 || { echo "openssl not installed"; exit 1; }
echo "[A] OK"

echo "[B] Start terminal polkit agent"
sudo pkttyagent --process $$ >/dev/null 2>&1 &
PKA=$!
trap 'kill $PKA >/dev/null 2>&1 || true' EXIT
echo "[B] OK"

echo "[C] Ensure GDM is running"
GDM_UNIT="gdm.service"; systemctl status "$GDM_UNIT" >/dev/null 2>&1 || GDM_UNIT="gdm3.service"
sudo systemctl enable --now "$GDM_UNIT" >/dev/null 2>&1 || true
echo "[C] OK"

echo "[D] System Remote Login: TLS, credentials, enable"
if id -u gnome-remote-desktop >/dev/null 2>&1; then
  sudo -u gnome-remote-desktop mkdir -p ~gnome-remote-desktop/.local/share/gnome-remote-desktop
  if command -v winpr-makecert >/dev/null 2>&1; then
    sudo -u gnome-remote-desktop winpr-makecert -silent -rdp -path ~gnome-remote-desktop/.local/share/gnome-remote-desktop tls
    SYS_KEY=~gnome-remote-desktop/.local/share/gnome-remote-desktop/tls.key
    SYS_CRT=~gnome-remote-desktop/.local/share/gnome-remote-desktop/tls.crt
  else
    sudo -u gnome-remote-desktop openssl req -new -newkey rsa:4096 -days 3650 -nodes -x509 -subj "/C=US/CN=GNOME" -keyout ~gnome-remote-desktop/.local/share/gnome-remote-desktop/tls.key -out ~gnome-remote-desktop/.local/share/gnome-remote-desktop/tls.crt >/dev/null 2>&1
    SYS_KEY=~gnome-remote-desktop/.local/share/gnome-remote-desktop/tls.key
    SYS_CRT=~gnome-remote-desktop/.local/share/gnome-remote-desktop/tls.crt
  fi
  sudo grdctl --system rdp set-tls-key "$SYS_KEY"
  sudo grdctl --system rdp set-tls-cert "$SYS_CRT"
fi
sudo grdctl --system rdp set-credentials "$RDP_USER" "$RDP_PASS"
sudo grdctl --system rdp enable
sudo systemctl enable --now gnome-remote-desktop.service >/dev/null 2>&1 || true
echo "[D] OK"

echo "[E] Open firewall for 3389 and 3390 if UFW present"
if command -v ufw >/dev/null 2>&1; then
  sudo ufw allow 3389/tcp >/dev/null 2>&1 || true
  sudo ufw allow 3390/tcp >/dev/null 2>&1 || true
fi
echo "[E] OK"

echo "[F] Prepare user TLS store"
USER_HOME="$(getent passwd "$RDP_USER" | cut -d: -f6)"
TLS_STORE="${USER_HOME}/.local/share/gnome-remote-desktop"
sudo install -d -m 0755 -o "$RDP_USER" -g "$RDP_USER" "$TLS_STORE"
if ! sudo test -e "${TLS_STORE}/rdp-tls.crt" -a -e "${TLS_STORE}/rdp-tls.key"; then
  sudo -u "$RDP_USER" openssl req -new -newkey rsa:4096 -days 3650 -nodes -x509 -subj "/C=US/CN=GNOME" -keyout "${TLS_STORE}/rdp-tls.key" -out "${TLS_STORE}/rdp-tls.crt" >/dev/null 2>&1
  sudo chown "$RDP_USER:$RDP_USER" "${TLS_STORE}/rdp-tls.crt" "${TLS_STORE}/rdp-tls.key"
  sudo chmod 0644 "${TLS_STORE}/rdp-tls.crt"
  sudo chmod 0600 "${TLS_STORE}/rdp-tls.key"
fi
echo "[F] OK"

echo "[G] Install one-shot user service to enable Desktop Sharing with same creds"
sudo -u "$RDP_USER" mkdir -p "${USER_HOME}/.config/systemd/user"
sudo -u "$RDP_USER" bash -lc "cat > '${USER_HOME}/.config/systemd/user/grd-desktop-sharing-once.service' <<'EOF'
[Unit]
Description=Configure GNOME Desktop Sharing once
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=oneshot
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=/usr/bin/grdctl rdp set-tls-cert %h/.local/share/gnome-remote-desktop/rdp-tls.crt
ExecStart=/usr/bin/grdctl rdp set-tls-key %h/.local/share/gnome-remote-desktop/rdp-tls.key
ExecStart=/usr/bin/grdctl rdp set-credentials __RDP_USER__ __RDP_PASS__
ExecStart=/usr/bin/grdctl rdp disable-view-only
ExecStart=/usr/bin/grdctl rdp enable
ExecStart=/usr/bin/systemctl --user start gnome-remote-desktop.service
ExecStart=/usr/bin/systemctl --user disable grd-desktop-sharing-once.service
RemainAfterExit=true

[Install]
WantedBy=graphical-session.target
EOF"
sudo -u "$RDP_USER" sed -i "s|__RDP_USER__|${RDP_USER}|g; s|__RDP_PASS__|${RDP_PASS}|g" "${USER_HOME}/.config/systemd/user/grd-desktop-sharing-once.service"
sudo -u "$RDP_USER" mkdir -p "${USER_HOME}/.config/systemd/user/graphical-session.target.wants"
sudo -u "$RDP_USER" ln -sf "${USER_HOME}/.config/systemd/user/grd-desktop-sharing-once.service" "${USER_HOME}/.config/systemd/user/graphical-session.target.wants/grd-desktop-sharing-once.service"
echo "[G] OK"

echo "[H] Restart GDM"
sudo systemctl restart "$GDM_UNIT" || true
sleep 2
echo "[H] OK"

echo "[I] Status"
sudo grdctl --system status || true
echo "[I] Done. Connect to :3389, log in as ${RDP_USER}; after first login, Desktop Sharing will auto-enable on :3390 with the same credentials."

