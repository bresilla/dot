#!/usr/bin/env bash
set -euo pipefail

# -------------------------------------------------------------------
# If ANY arguments are provided, forward directly to git commit
# -------------------------------------------------------------------

if [ "$#" -gt 0 ]; then
  exec git commit --no-verify "$@"
fi

# -------------------------------------------------------------------
# No arguments → AI-powered commit flow
# -------------------------------------------------------------------

TYPES=(
  feat
  fix
  chore
  refactor
  docs
  test
  perf
  build
  ci
)

EDITOR_CMD="${EDITOR:-nvim}"

# ---- PRECHECKS ------------------------------------------------------

command -v gum >/dev/null 2>&1 || {
  echo "gum not found. Install https://github.com/charmbracelet/gum"
  exit 1
}

command -v aichat >/dev/null 2>&1 || {
  echo "aichat not found in PATH"
  exit 1
}

git rev-parse --git-dir >/dev/null 2>&1 || {
  echo "Not inside a git repository"
  exit 1
}

# ---- STAGED CHANGES CHECK ------------------------------------------

if git diff --cached --quiet; then
  echo "No changes in staging. Run 'git add' first."
  exit 1
fi

# ---- SELECT COMMIT TYPE --------------------------------------------

SELECTED_TYPE=$(
  printf "%s\n" "${TYPES[@]}" |
    gum choose --header "Select Conventional Commit type"
)

# ---- AI COMMIT MESSAGE ---------------------------------------------

PROMPT="You are an expert at writing Git commits following the Conventional Commits specification.

The selected commit type is: ${SELECTED_TYPE}

Generate ONE commit message with this EXACT format:

${SELECTED_TYPE}: <concise summary under 50 characters>

<empty line>
- Bullet list of detailed changes
- One change per line
- Use imperative mood (add, fix, update)
- Be specific about what changed and why

Changes to analyze:
$(git diff --cached --stat)

Full diff:
$(git diff --cached)
"

# MSG="$(aichat "$PROMPT")"
MSG="$(printf "%s\n" "$PROMPT" | aichat)"

# ---- EDIT + COMMIT --------------------------------------------------

COMMIT_MSG_FILE="$(git rev-parse --git-dir)/COMMIT_EDITMSG"

printf "%s\n" "$MSG" > "$COMMIT_MSG_FILE"

"$EDITOR_CMD" "$COMMIT_MSG_FILE"

if [ -s "$COMMIT_MSG_FILE" ]; then
  git commit --no-verify -F "$COMMIT_MSG_FILE"
else
  echo "Commit message empty. Commit aborted."
  exit 1
fi

