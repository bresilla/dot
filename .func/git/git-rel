#!/bin/bash
set -e
[ "$(git rev-parse --abbrev-ref HEAD)" != "develop" ] && { echo "Must be on develop branch"; exit 1; }
VERI="$HOME/.func/code/veri"
type="$1"
original_branch=$(git rev-parse --abbrev-ref HEAD)
trap 'git checkout "$original_branch" >/dev/null 2>&1 || true' EXIT

current_version=$("$VERI") || exit 1
"$VERI" "$type" || exit 1
version=$("$VERI")

# Dereference annotated tags to get the actual commit
latest_tag=$(git describe --tags --abbrev=0 2>/dev/null || echo "")
if [[ -n "$latest_tag" ]]; then
    # Use ^{} to dereference the tag to its commit
    changelog=$(git cliff "${latest_tag}^{}"..HEAD --strip all)
    git cliff --tag "$version" "${latest_tag}^{}"..HEAD --prepend CHANGELOG.md
else
    changelog=$(git cliff --unreleased --strip all)
    git cliff --tag "$version" --unreleased --prepend CHANGELOG.md
fi

if [[ "$type" == "minor" || "$type" == "major" ]]; then
    if command -v git-codename &>/dev/null; then
        release_name=$(git-codename "$changelog")
        echo "----------------- $release_name -----------------"
    fi
fi

git add -A
git commit --no-verify -m "chore(release): prepare for $version"
git tag -a "$version" -m "$version" -m "$changelog"
git push --follow-tags --force --set-upstream origin "$original_branch"

git checkout main
git pull origin main
git merge develop || {
    git merge --abort 2>/dev/null || true
}
git push origin main

gh release create "$version" --notes "$changelog"
