#!/bin/bash
set -e

[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] && { echo "Refusing to run on main"; exit 1; }

VERI="$HOME/.func/code/veri"
type="$1"
"$VERI" "$type" || exit 1

current_branch=$(git rev-parse --abbrev-ref HEAD)
current_version=$("$VERI") || exit 1
version=$("$VERI")
latest_tag=$(git describe --tags --abbrev=0 2>/dev/null || echo "")

if [[ -n "$latest_tag" ]]; then
    changelog=$(git cliff "$latest_tag"..HEAD --strip all)
    git cliff --tag "$version" "$latest_tag"..HEAD --prepend CHANGELOG.md
else
    changelog=$(git cliff --unreleased --strip all)
    git cliff --tag "$version" --unreleased --prepend CHANGELOG.md
fi

if [[ "$type" == "minor" || "$type" == "major" ]]; then
    if command -v git-codename &>/dev/null; then
        release_name=$(git-codename "$changelog")
        echo "----------------- $release_name -----------------"
    fi
fi

git add -A
git commit -m "chore(release): prepare for $version"

echo "------------------------------------------------------------"
echo "$changelog"
echo "------------------------------------------------------------"

git tag -a "$version" -m "$version" -m "$changelog"

git push --follow-tags --force --set-upstream origin "$current_branch"

git checkout main
git pull origin main
git merge develop
git push origin main

git checkout "$current_branch"

gh release create "$version" --notes "$changelog"
