#!/usr/bin/env bash
set -euo pipefail

tw=2752
th=1536
fuzz_pct=8

input="$(cat)"
[ -n "$input" ] || { echo "no input" >&2; exit 1; }

line="$(printf '%s' "$input" | tail -n1)"
line="${line%$'\r'}"
line="$(printf '%s' "$line" | sed 's/[[:space:]]*$//')"
inpath="$(printf '%s' "$line" | sed 's/%\+$//')"

[ -n "$inpath" ] || { echo "no path in input" >&2; exit 1; }
[ -f "$inpath" ] || { echo "file not found: $inpath" >&2; exit 1; }

ext="${inpath##*.}"
[ "$ext" != "$inpath" ] || ext="png"

tmp_trim="$(mktemp --suffix=."$ext")"

magick "$inpath" -fuzz "${fuzz_pct}%" -trim +repage "$tmp_trim"
dims="$(magick identify -format '%[fx:min(w,h*16/9)]x%[fx:min(h,w*9/16)]' "$tmp_trim")"
magick "$tmp_trim" -gravity center -crop "${dims}+0+0" +repage -resize "${tw}x${th}!" "$inpath"

rm -f "$tmp_trim"

echo "$inpath"

