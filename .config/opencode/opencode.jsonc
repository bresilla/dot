{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["Makefile"],
  "plugin": [
    "@simonwjackson/opencode-direnv"
  ],
  "mcp": {
    "subcog": {
      "type": "local",
      "enabled": true,
      "command": ["/env/bin/subcog", "serve"]
    },
    "engram": {
       "type": "local",
       "enabled": true,
       "command": ["engram", "mcp"]
    }
  },
    "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.1.253:11434/v1"
      },
      "models": {
        "qwen3.5:122b": {},
        "qwen3.6:35b": {},
        "ornith:35b": {},
      }
    }
  }
}
