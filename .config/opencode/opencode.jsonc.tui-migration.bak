{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "instructions": ["Makefile"],
  "plugin": [
    "@simonwjackson/opencode-direnv"
  ],
  "mcp": {
    "subcog": {
      "type": "local",
      "enabled": true,
      "command": ["/env/bin/subcog", "serve"]
    },
    "engram": {
       "type": "local",
       "enabled": true,
       "command": ["engram", "mcp"]
    }
  }
}
