{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": true,
  "instructions": ["Makefile"],
  "permission": {
    "bash": "ask",
    "write": "ask",
    "edit": "ask",
    "git": "allow",
    "fd": "allow",
    "find": "allow",
    "grep": "allow",
    "tree": "allow",
    "list": "allow",
    "ls": "allow",
    "rg": "allow",
    "sed": "allow",
    "glob": "allow",
    "ls": "allow",
    "ls": "allow",
    "rg": "allow",
    "sed": "allow",
    "head": "allow",
    "tail": "allow",
    "cat": "allow",
    "read": "allow",
    "make": "allow",
    "cmake": "allow",
  },
  "mode": {
    "build": {
      "model": "anthropic/claude-sonnet-4-5-20250929",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "model": "anthropic/claude-haiku-4-20250514",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "god": {},
  },
  "agent": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "model": "anthropic/claude-sonnet-4-5-20250929",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "tools": {
        "write": false,
        "edit": false
      }
    }
  }
}
