// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                           ZELLIJ CONFIGURATION                           ║
// ║                    Aesthetic match with tmux/promptline                   ║
// ╚══════════════════════════════════════════════════════════════════════════╝


// ════════════════════════════════════════════════════════════════════════════
// GENERAL OPTIONS
// ════════════════════════════════════════════════════════════════════════════

default_shell "/usr/bin/zsh"
default_layout "default"
default_mode "normal"

mouse_mode true
scroll_buffer_size 100000
copy_on_select true
copy_command "wl-copy"

pane_frames false
simplified_ui true
styled_underlines true

session_serialization true
serialize_pane_viewport false

show_startup_tips false
show_release_notes false

on_force_close "detach"

ui {
    pane_frames {
        rounded_corners true
        hide_session_name false
    }
}


// ════════════════════════════════════════════════════════════════════════════
// THEME DEFINITION - New format for zellij 0.40+
// ════════════════════════════════════════════════════════════════════════════

theme "bresilla"

// Using 8-bit color indices (single number = 256-color palette)
// Tabs: inactive = bg:237 fg:0, active = bg:1 fg:15
themes {
    bresilla {
        // Inactive tabs (ribbons)
        ribbon_unselected {
            base 0             // fg: black text
            background 237     // bg: dark grey
            emphasis_0 7
            emphasis_1 0
            emphasis_2 237
            emphasis_3 0
        }
        // Active tabs (ribbons)
        ribbon_selected {
            base 15            // fg: white text
            background 1       // bg: red accent
            emphasis_0 15
            emphasis_1 0
            emphasis_2 1
            emphasis_3 15
        }
        // Text elements
        text_unselected {
            base 15
            background 0
            emphasis_0 1
            emphasis_1 7
            emphasis_2 15
            emphasis_3 237
        }
        text_selected {
            base 15
            background 237
            emphasis_0 1
            emphasis_1 15
            emphasis_2 7
            emphasis_3 237
        }
        // Tables
        table_title {
            base 1
            background 0
            emphasis_0 15
            emphasis_1 7
            emphasis_2 1
            emphasis_3 237
        }
        table_cell_unselected {
            base 15
            background 0
            emphasis_0 1
            emphasis_1 7
            emphasis_2 15
            emphasis_3 237
        }
        table_cell_selected {
            base 15
            background 237
            emphasis_0 1
            emphasis_1 15
            emphasis_2 7
            emphasis_3 237
        }
        // Lists
        list_unselected {
            base 15
            background 0
            emphasis_0 1
            emphasis_1 7
            emphasis_2 15
            emphasis_3 237
        }
        list_selected {
            base 15
            background 237
            emphasis_0 1
            emphasis_1 15
            emphasis_2 7
            emphasis_3 237
        }
        // Pane frames
        frame_unselected {
            base 237
            background 0
            emphasis_0 237
            emphasis_1 237
            emphasis_2 15
            emphasis_3 7
        }
        frame_selected {
            base 15
            background 0
            emphasis_0 1
            emphasis_1 15
            emphasis_2 7
            emphasis_3 237
        }
        frame_highlight {
            base 1
            background 0
            emphasis_0 1
            emphasis_1 15
            emphasis_2 7
            emphasis_3 237
        }
        // Exit codes
        exit_code_success {
            base 2
            background 0
            emphasis_0 15
            emphasis_1 0
            emphasis_2 7
            emphasis_3 237
        }
        exit_code_error {
            base 1
            background 0
            emphasis_0 15
            emphasis_1 0
            emphasis_2 15
            emphasis_3 237
        }
        // Multiplayer
        multiplayer_user_colors {
            player_1 1
            player_2 237
            player_3 0
            player_4 15
            player_5 7
            player_6 0
            player_7 6
            player_8 0
            player_9 0
            player_10 0
        }
    }
}


// ════════════════════════════════════════════════════════════════════════════
// KEYBINDINGS - Matching tmux shortcuts
// ════════════════════════════════════════════════════════════════════════════

keybinds clear-defaults=true {

    // ─────────────────────────────────────────────────────────────────────────
    // NORMAL MODE - Main shortcuts (like tmux -n bindings)
    // ─────────────────────────────────────────────────────────────────────────
    normal {
        // Pane splits (matching tmux C-n and C-v)
        bind "Ctrl n" { NewPane "Right"; }
        bind "Ctrl v" { NewPane "Down"; }

        // Tab/window management (matching tmux C-t)
        bind "Ctrl t" { NewTab; }

        // Pane navigation (matching tmux C-arrows)
        bind "Ctrl Left" { MoveFocus "Left"; }
        bind "Ctrl Down" { MoveFocus "Down"; }
        bind "Ctrl Up" { MoveFocus "Up"; }
        bind "Ctrl Right" { MoveFocus "Right"; }

        // Tab navigation (matching tmux C-End/C-Home)
        bind "Ctrl End" { GoToNextTab; }
        bind "Ctrl Home" { GoToPreviousTab; }

        // Toggle status bar (matching tmux C-s)
        bind "Ctrl s" { TogglePaneFrames; }

        // External tools via Run command (matching tmux M-* popups)
        bind "Alt 0" { Run "lazygit" { floating true; }; }
        bind "Alt 9" { Run "perles" { floating true; }; }

        // AI tools
        bind "Alt 1" { Run "opencode" { floating true; }; }
        bind "Alt 2" { Run "opencode" { floating true; }; }
        bind "Alt 3" { Run "opencode" { floating true; }; }

        // Build/Config (matching tmux F4/F5)
        bind "F4" { Run "_c" { floating true; }; }
        bind "F5" { Run "_b" { floating true; }; }

        // Edux inter commands (matching tmux C-e, C-o, C-p, C-f, C-b, C-q)
        bind "Ctrl e" { Run "edux" "inter" "explorer" { floating true; close_on_exit true; }; }
        bind "Ctrl o" { Run "edux" "inter" "replace" { floating true; close_on_exit true; }; }
        bind "Ctrl p" { Run "edux" "inter" "picker" { floating true; close_on_exit true; }; }
        bind "Ctrl f" { Run "edux" "inter" "finder" { floating true; close_on_exit true; }; }
        bind "Ctrl b" { Run "edux" "inter" "buffers" { floating true; close_on_exit true; }; }
        bind "Ctrl q" { Run "edux" "inter" "quickfix" { floating true; close_on_exit true; }; }

        // Close pane
        bind "Ctrl x" { CloseFocus; }

        // Fullscreen toggle
        bind "Ctrl z" { ToggleFocusFullscreen; }

        // Floating panes toggle
        bind "Ctrl w" { ToggleFloatingPanes; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // LOCKED MODE
    // ─────────────────────────────────────────────────────────────────────────
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PANE MODE
    // ─────────────────────────────────────────────────────────────────────────
    pane {
        bind "h" "Left" { MoveFocus "Left"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "l" "Right" { MoveFocus "Right"; }

        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "s" { NewPane "stacked"; SwitchToMode "Normal"; }

        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "i" { TogglePanePinned; SwitchToMode "Normal"; }

        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "p" { SwitchFocus; }
        bind "Ctrl p" { SwitchToMode "Normal"; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // TAB MODE
    // ─────────────────────────────────────────────────────────────────────────
    tab {
        bind "h" "Left" "Up" "k" { GoToPreviousTab; }
        bind "l" "Right" "Down" "j" { GoToNextTab; }

        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "b" { BreakPane; SwitchToMode "Normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; }

        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        bind "Ctrl t" { SwitchToMode "Normal"; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // RESIZE MODE
    // ─────────────────────────────────────────────────────────────────────────
    resize {
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }

        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }

        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }

        bind "Ctrl r" { SwitchToMode "Normal"; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // MOVE MODE
    // ─────────────────────────────────────────────────────────────────────────
    move {
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }

        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }

        bind "Ctrl m" { SwitchToMode "Normal"; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SCROLL MODE
    // ─────────────────────────────────────────────────────────────────────────
    scroll {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }

        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SEARCH MODE
    // ─────────────────────────────────────────────────────────────────────────
    search {
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "Ctrl b" "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }

        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }

        bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "Esc" { SwitchToMode "Normal"; }
    }

    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SESSION MODE
    // ─────────────────────────────────────────────────────────────────────────
    session {
        bind "d" { Detach; }
        bind "Ctrl o" { SwitchToMode "Normal"; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // RENAME MODES
    // ─────────────────────────────────────────────────────────────────────────
    renametab {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
    }

    renamepane {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SHARED BINDINGS - Available in all modes except locked
    // ─────────────────────────────────────────────────────────────────────────
    shared_except "locked" {
        // Lock mode
        bind "Ctrl g" { SwitchToMode "Locked"; }

        // Alt navigation (vim-like, same as tmux Alt bindings)
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }

        // Alt resize
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }

        // Alt layout switching
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }

        // Tab movement
        bind "Alt i" { MoveTab "Left"; }
        bind "Alt o" { MoveTab "Right"; }
    }

    // Mode switching (use Alt + letter to avoid conflicts with direct bindings)
    shared_except "locked" "pane" {
        bind "Alt p" { SwitchToMode "Pane"; }
    }
    shared_except "locked" "tab" {
        bind "Alt t" { SwitchToMode "Tab"; }
    }
    shared_except "locked" "resize" {
        bind "Alt r" { SwitchToMode "Resize"; }
    }
    shared_except "locked" "move" {
        bind "Alt m" { SwitchToMode "Move"; }
    }
    shared_except "locked" "session" {
        bind "Ctrl o" { SwitchToMode "Session"; }
    }
    shared_except "locked" "scroll" {
        bind "Alt s" { SwitchToMode "Scroll"; }
    }
}


// ════════════════════════════════════════════════════════════════════════════
// PLUGINS
// ════════════════════════════════════════════════════════════════════════════

plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    about location="zellij:about"
}

load_plugins {
}

web_client {
    font "monospace"
}
