// Default layout with zjstatus - matches tmux/promptline aesthetic
// Layout: LEFT: time | netspeed | uptime  CENTER: tabs  RIGHT: session | cpu | mem | battery

layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                // Format matching promptline's __tmuxline layout
                // Left: time | netspeed | uptime
                // Center: tabs
                // Right: session | cpu | mem | battery
                format_left   "#[bg=237,fg=250,bold] {datetime} #[bg=0,fg=237,nobold]#[bg=1,fg=237]#[bg=1,fg=0] {command_netspeed} #[bg=0,fg=1]#[fg=7] {command_uptime}"
                format_center "{tabs}"
                format_right  "#[fg=7]{session} #[fg=1]#[bg=1,fg=0] {command_cpu} #[bg=0,fg=1]#[fg=1]#[bg=1,fg=0] {command_mem} #[bg=0,fg=1]{command_bat}"
                format_space  ""

                // No border
                border_enabled  "false"

                // Hide frames for cleaner look
                hide_frame_for_single_pane "true"

                // Tab styling - minimal squares with padding
                // Inactive: bg:237 (dark grey square)
                // Active: bg:1 (red/accent square)
                tab_normal              "#[bg=237]   #[bg=0]"
                tab_active              "#[bg=1]   #[bg=0]"
                tab_separator           " "

                // Mode indicator (matches promptline minimal style)
                mode_normal             ""
                mode_locked             "#[bg=1,fg=15,bold] LOCKED #[bg=0,fg=1]"
                mode_pane               "#[bg=1,fg=15,bold] PANE #[bg=0,fg=1]"
                mode_tab                "#[bg=1,fg=15,bold] TAB #[bg=0,fg=1]"
                mode_resize             "#[bg=1,fg=15,bold] RESIZE #[bg=0,fg=1]"
                mode_scroll             "#[bg=1,fg=15,bold] SCROLL #[bg=0,fg=1]"
                mode_session            "#[bg=1,fg=15,bold] SESSION #[bg=0,fg=1]"
                mode_move               "#[bg=1,fg=15,bold] MOVE #[bg=0,fg=1]"

                // Datetime widget (time) - matches __timenow
                datetime          "{format}"
                datetime_format   "%H:%M"
                datetime_timezone "Europe/Berlin"

                // Network speed - matches __netspeed (▲upload | ▼download)
                command_netspeed_command    "/home/bresilla/.config/zellij/scripts/netspeed.sh"
                command_netspeed_format     "{stdout}"
                command_netspeed_interval   "2"
                command_netspeed_rendermode "static"

                // Uptime - matches __uptime (compact format)
                command_uptime_command      "/home/bresilla/.config/zellij/scripts/uptime.sh"
                command_uptime_format       "{stdout}"
                command_uptime_interval     "60"
                command_uptime_rendermode   "static"

                // CPU stats - matches __cpustats
                command_cpu_command         "/home/bresilla/.config/zellij/scripts/cpu.sh"
                command_cpu_format          "{stdout}"
                command_cpu_interval        "2"
                command_cpu_rendermode      "static"

                // Memory usage - matches __memoryuse
                command_mem_command         "/home/bresilla/.config/zellij/scripts/memory.sh"
                command_mem_format          "{stdout}"
                command_mem_interval        "5"
                command_mem_rendermode      "static"

                // Battery - matches __battery (only shows if battery exists)
                // Shows red when discharging (like promptline)
                command_bat_command         "/home/bresilla/.config/zellij/scripts/battery.sh"
                command_bat_format          "#[fg=237]#[bg=237,fg=0]#[bg=0,fg=237]#[fg=250,bg=237] {stdout} "
                command_bat_interval        "30"
                command_bat_rendermode      "static"
            }
        }
    }
    tab name="main" focus=true
}
