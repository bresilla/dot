set $super Mod4
set $meta Mod1
set $menu Control_R

input type:keyboard {
  xkb_layout us
  xkb_options caps:hyper
}

input type:touchpad {
  natural_scroll disabled
}

focus_follows_mouse yes

gaps inner 5
gaps outer 10
default_border pixel 4

output "Philips Consumer Electronics Company PHL 241B7Q UHB1932001606" mode 1920x1080 pos 1105 1080 scale 1
output "Philips Consumer Electronics Company PHL 241B7Q UHB1916006362" mode 1920x1080 pos 3025 1080 scale 1
output "Philips Consumer Electronics Company PHL 346P1C UK02307049191" mode 3440x1440 pos 0 720 scale 1
output "Philips Consumer Electronics Company 34B2U5600 UK02425052661" mode 3440x1440 pos 3440 720 scale 1
output "Samsung Electric Company LS32D70xE HK2X900532" mode 3840x2160 pos 0 0 scale 1
output "Samsung Electric Company LS32D70xE HK2Y400739" mode 3840x2160 pos 3840 0 scale 1
output "Samsung Display Corp. 0x414D" mode 3456x2160 pos 2132 2160 scale 1

exec gnome-keyring-daemon --start
exec /env/bin/lule daemon --no-pipe --loop=60 -- start
exec /env/bin/clipse -listen
exec /env/bin/evsieve --input /dev/input/event2 grab --map key:capslock key:f12 --output
exec lemonade server --port=12244 --allow="172.30.0.0/24,0.0.0.0/0,::/0"

bindsym $super+$meta+Return exec /env/dot/.func/wm/swayscratch ask "[float;size 80% 80%;center] kitty --title ask -e /env/bin/aichat"
bindsym $super+space exec /env/dot/.func/wm/swayscratch noteing "[float;size 90% 60%;center] kitty --title noteing"
bindsym $meta+space exec /env/dot/.func/wm/swayscratch main "[float;size 90% 60%;center] kitty --title main"
bindsym $super+$meta+space exec /env/dot/.func/wm/swayscratch browsy "[float;size 60% 20%;center] alacritty --title browsy -e browsy"
bindsym $super+$meta+b exec /env/dot/.func/wm/swayscratch browsy "[float;size 60% 20%;center] alacritty --title browsy -e browsy"
bindsym $super+$meta+x exec /env/dot/.func/wm/swayscratch runny "[float;size 60% 20%;center] alacritty --title runny -e runny"
bindsym $super+$meta+a exec /env/dot/.func/wm/swayscratch appy "[float;size 60% 20%;center] alacritty --title appy -e appy"

bindsym $super+L exec swaylock
bindsym $super+Escape kill
bindsym $super+Return exec kitty --override window_padding_width=0
bindsym $meta+Return exec kitty

bindsym $super+$meta+Up workspace prev_on_output
bindsym $super+$meta+Down workspace next_on_output
bindsym $super+$meta+Shift+Up move container to workspace prev; workspace prev_on_output
bindsym $super+$meta+Shift+Down move container to workspace next; workspace next_on_output

bindsym $super+Left focus left
bindsym $super+Right focus right
bindsym $super+Up focus up
bindsym $super+Down focus down

bindsym $meta+Left move left
bindsym $meta+Right move right
bindsym $meta+Up move up
bindsym $meta+Down move down

bindsym $super+f floating toggle
bindsym $super+s fullscreen toggle

bindsym XF86AudioMute exec volume_control mute
bindsym XF86AudioRaiseVolume exec volume_control up
bindsym XF86AudioLowerVolume exec volume_control down
bindsym XF86AudioPlay exec playerctl next
bindsym $super+$meta+F4 exec systemctl --user restart spotifyd
bindsym XF86MonBrightnessDown exec light_control down
bindsym XF86MonBrightnessUp exec light_control up

bindsym Insert exec capture i

bindsym $menu+Return exec play
bindsym $menu+Space exec mpv_control cycle
bindsym $menu+comma exec mpv_control backwards 10
bindsym $menu+period exec mpv_control forewards 10

for_window [app_id=".*float.*"] floating enable
for_window [class=".*float.*"] floating enable
for_window [app_id="mpv"] floating enable
for_window [class="mpv"] floating enable
for_window [app_id="scrcpy"] floating enable
for_window [class="scrcpy"] floating enable
for_window [title=".*matplotlib.*"] floating enable
for_window [title=".*opencv.*"] floating enable

floating_modifier $super
