#!/usr/bin/env python3

import argparse
import json
import math
import os
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


REVERSE = True
BAR_CHAR = "━"

RESET = "\033[0m"
BOLD = "\033[1m"
DEFAULT_FG = "\033[39m"
DEFAULT_BG = "\033[49m"

USAGE_FG = "\033[38;5;1m"
USAGE_BG = "\033[48;5;1m"

TIME_FG = "\033[38;5;239m"
TIME_BG = "\033[48;5;239m"

USE_COLOR = (
    sys.stdout.isatty()
    and "NO_COLOR" not in os.environ
    and os.environ.get("TERM") != "dumb"
)


def parse_arguments():
    parser = argparse.ArgumentParser(
        description="Display Codex, Claude, and Antigravity usage limits."
    )

    parser.add_argument(
        "--json",
        action="store_true",
        help="Output machine-readable JSON.",
    )

    parser.add_argument(
        "--provider",
        choices=("codex", "claude", "antigravity", "google"),
        help="Only query the selected provider.",
    )

    parser.add_argument(
        "--context",
        choices=("session", "week"),
        help="Only show the selected limit window.",
    )

    return parser.parse_args()


def clamp(value, minimum=0.0, maximum=100.0):
    return max(minimum, min(maximum, value))


def get_json(url, headers, method="GET", data=None):
    request = Request(
        url,
        headers=headers,
        data=data,
        method=method,
    )

    try:
        with urlopen(request, timeout=20) as response:
            encoding = response.headers.get_content_charset() or "utf-8"
            return json.loads(response.read().decode(encoding))

    except HTTPError as error:
        body = error.read().decode(
            "utf-8",
            errors="replace",
        ).strip()

        if error.code in (401, 403):
            raise RuntimeError(
                f"authentication failed: HTTP {error.code}; log in again"
            ) from error

        raise RuntimeError(
            f"HTTP {error.code}: {body[:300] or error.reason}"
        ) from error

    except URLError as error:
        raise RuntimeError(
            f"network error: {error.reason}"
        ) from error


def parse_reset(value):
    if isinstance(value, (int, float)):
        return datetime.fromtimestamp(
            value,
            timezone.utc,
        )

    if isinstance(value, str):
        value = value.strip()

        try:
            return datetime.fromtimestamp(
                float(value),
                timezone.utc,
            )
        except ValueError:
            return datetime.fromisoformat(
                value.replace("Z", "+00:00")
            ).astimezone(timezone.utc)

    raise ValueError(
        f"invalid reset time: {value!r}"
    )


def reset_seconds(reset_at):
    remaining = (
        parse_reset(reset_at)
        - datetime.now(timezone.utc)
    )

    return max(
        0,
        math.ceil(remaining.total_seconds()),
    )


def reset_text(reset_at):
    seconds = reset_seconds(reset_at)

    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)

    if days:
        return f"in {days}d {hours}h"

    if hours:
        return f"in {hours}h {minutes}m"

    if minutes:
        return f"in {minutes}m {seconds}s"

    return f"in {seconds}s"


def reset_iso(reset_at):
    return (
        parse_reset(reset_at)
        .isoformat()
        .replace("+00:00", "Z")
    )


def time_left_percent(reset_at, window_seconds):
    return clamp(
        reset_seconds(reset_at)
        / float(window_seconds)
        * 100.0
    )


def overlay_bar(
    usage_left,
    time_left,
    width,
    reverse=REVERSE,
):
    usage_cells = round(
        width * clamp(usage_left) / 100
    )

    time_cells = round(
        width * clamp(time_left) / 100
    )

    output = [RESET, "|"]

    for index in range(width):
        usage_active = index < usage_cells
        time_active = index < time_cells

        if not USE_COLOR:
            if usage_active and time_active:
                output.append(BAR_CHAR)
            elif usage_active:
                output.append("·" if reverse else BAR_CHAR)
            elif time_active:
                output.append(BAR_CHAR if reverse else "·")
            else:
                output.append(" ")

            continue

        if reverse:
            output.append(
                USAGE_BG if usage_active else DEFAULT_BG
            )

            if time_active:
                output.append(TIME_FG)
                output.append(BAR_CHAR)
            else:
                output.append(DEFAULT_FG)
                output.append(" ")

        else:
            output.append(
                TIME_BG if time_active else DEFAULT_BG
            )

            if usage_active:
                output.append(USAGE_FG)
                output.append(BAR_CHAR)
            else:
                output.append(DEFAULT_FG)
                output.append(" ")

    output.extend([RESET, "|"])

    return "".join(output)


def codex_auth_path():
    codex_home = Path(
        os.environ.get(
            "CODEX_HOME",
            "~/.codex",
        )
    ).expanduser()

    return codex_home / "auth.json"


def load_codex_credentials():
    path = codex_auth_path()

    if not path.exists():
        raise RuntimeError(
            f"{path} does not exist; run `codex login`"
        )

    data = json.loads(path.read_text())
    tokens = data.get("tokens") or {}

    access_token = (
        tokens.get("access_token")
        or tokens.get("accessToken")
    )

    account_id = (
        tokens.get("account_id")
        or tokens.get("accountId")
    )

    if not access_token:
        raise RuntimeError(
            f"no Codex OAuth access token found in {path}"
        )

    return access_token, account_id


def fetch_codex():
    access_token, account_id = load_codex_credentials()

    headers = {
        "Authorization": f"Bearer {access_token}",
        "Accept": "application/json",
        "User-Agent": "ailimit/1.0",
    }

    if account_id:
        headers["ChatGPT-Account-Id"] = account_id

    data = get_json(
        "https://chatgpt.com/backend-api/wham/usage",
        headers,
    )

    rate_limit = data.get("rate_limit") or {}
    primary = rate_limit.get("primary_window")
    secondary = rate_limit.get("secondary_window")

    session_data = None
    weekly_data = None

    for window in (primary, secondary):
        if not window or not isinstance(window, dict):
            continue
        win_seconds = int(window.get("limit_window_seconds", 0))
        if win_seconds >= 86400:
            weekly_data = window
        else:
            session_data = window

    now_iso = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")

    if session_data:
        session_left = clamp(
            100.0 - float(session_data.get("used_percent", 0))
        )
        session_reset = session_data.get("reset_at") or now_iso
        session_win = int(
            session_data.get("limit_window_seconds", 5 * 60 * 60)
        )
    else:
        session_left = 100.0
        session_reset = now_iso
        session_win = 5 * 60 * 60

    if weekly_data:
        weekly_left = clamp(
            100.0 - float(weekly_data.get("used_percent", 0))
        )
        weekly_reset = weekly_data.get("reset_at") or now_iso
        weekly_win = int(
            weekly_data.get("limit_window_seconds", 7 * 24 * 60 * 60)
        )
    else:
        weekly_left = 100.0
        weekly_reset = now_iso
        weekly_win = 7 * 24 * 60 * 60

    return {
        "id": "codex",
        "name": "Codex",
        "session": {
            "left": session_left,
            "reset": session_reset,
            "window": session_win,
        },
        "weekly": {
            "left": weekly_left,
            "reset": weekly_reset,
            "window": weekly_win,
        },
    }


def claude_credentials_path():
    root = os.environ.get(
        "CLAUDE_CONFIG_DIR",
        "~/.claude",
    )

    root = root.split(",", maxsplit=1)[0]

    return (
        Path(root).expanduser()
        / ".credentials.json"
    )


def load_claude_credentials():
    path = claude_credentials_path()

    if not path.exists():
        raise RuntimeError(
            f"{path} does not exist; run `claude login`"
        )

    data = json.loads(path.read_text())
    oauth = data.get("claudeAiOauth") or {}
    access_token = oauth.get("accessToken")

    if not access_token:
        raise RuntimeError(
            f"no Claude OAuth access token found in {path}"
        )

    return access_token


def fetch_claude():
    access_token = load_claude_credentials()

    data = get_json(
        "https://api.anthropic.com/api/oauth/usage",
        {
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
            "Content-Type": "application/json",
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": "claude-code/2.1.0",
        },
    )

    session = data.get("five_hour")
    weekly = data.get("seven_day")

    if not session or not weekly:
        raise RuntimeError(
            "Claude response did not contain session and weekly limits"
        )

    return {
        "id": "claude",
        "name": "Claude",
        "session": {
            "left": clamp(
                100.0 - float(session["utilization"])
            ),
            "reset": session["resets_at"],
            "window": 5 * 60 * 60,
        },
        "weekly": {
            "left": clamp(
                100.0 - float(weekly["utilization"])
            ),
            "reset": weekly["resets_at"],
            "window": 7 * 24 * 60 * 60,
        },
    }


def antigravity_credentials_path():
    path = Path(
        os.environ.get(
            "ANTIGRAVITY_CONFIG_DIR",
            "~/.gemini/antigravity-cli",
        )
    ).expanduser() / "antigravity-oauth-token"
    return path


def load_antigravity_credentials():
    path = antigravity_credentials_path()

    if not path.exists():
        alt_path = Path("~/.gemini/antigravity-oauth-token").expanduser()
        if alt_path.exists():
            path = alt_path
        else:
            raise RuntimeError(
                f"{path} does not exist; log in to Antigravity"
            )

    data = json.loads(path.read_text())
    token_obj = data.get("token") or data
    access_token = token_obj.get("access_token")

    if not access_token:
        raise RuntimeError(
            f"no Antigravity OAuth access token found in {path}"
        )

    return access_token


def fetch_antigravity():
    access_token = load_antigravity_credentials()

    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "User-Agent": "antigravity/1.0",
    }

    now_iso = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")

    try:
        data = get_json(
            "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
            headers,
            method="POST",
            data=b"{}",
        )

        groups = data.get("groups") or []
        gemini_group = None
        for group in groups:
            if "gemini" in group.get("displayName", "").lower():
                gemini_group = group
                break
        if not gemini_group and groups:
            gemini_group = groups[0]

        if gemini_group:
            session_info = None
            weekly_info = None

            for bucket in gemini_group.get("buckets", []):
                window_type = bucket.get("window", "").lower()
                bucket_id = bucket.get("bucketId", "").lower()
                display_name = bucket.get("displayName", "").lower()

                if "5h" in window_type or "5h" in bucket_id or "five" in display_name:
                    session_info = bucket
                elif "weekly" in window_type or "weekly" in bucket_id or "week" in display_name:
                    weekly_info = bucket

            session_left = (
                clamp(float(session_info.get("remainingFraction", 1.0)) * 100.0)
                if session_info else 100.0
            )
            session_reset = session_info.get("resetTime") if session_info else now_iso

            weekly_left = (
                clamp(float(weekly_info.get("remainingFraction", 1.0)) * 100.0)
                if weekly_info else 100.0
            )
            weekly_reset = weekly_info.get("resetTime") if weekly_info else now_iso

            return {
                "id": "antigravity",
                "name": "Antigravity",
                "session": {
                    "left": session_left,
                    "reset": session_reset,
                    "window": 5 * 60 * 60,
                },
                "weekly": {
                    "left": weekly_left,
                    "reset": weekly_reset,
                    "window": 7 * 24 * 60 * 60,
                },
            }
    except Exception:
        pass

    data = get_json(
        "https://cloudcode-pa.googleapis.com/v1internal:fetchAvailableModels",
        headers,
        method="POST",
        data=b"{}",
    )

    models = data.get("models") or {}
    default_model = data.get("defaultAgentModelId") or "gemini-3.6-flash-tiered"

    quota_info = None
    if default_model in models and "quotaInfo" in models[default_model]:
        quota_info = models[default_model]["quotaInfo"]

    if not quota_info:
        for model_id, model_data in models.items():
            if isinstance(model_data, dict) and "quotaInfo" in model_data:
                qi = model_data["quotaInfo"]
                if "remainingFraction" in qi:
                    quota_info = qi
                    if "resetTime" in qi:
                        break

    if not quota_info:
        raise RuntimeError(
            "Antigravity response did not contain quota information"
        )

    remaining_fraction = float(quota_info.get("remainingFraction", 1.0))
    usage_left = clamp(remaining_fraction * 100.0)
    reset_at = quota_info.get("resetTime") or now_iso

    return {
        "id": "antigravity",
        "name": "Antigravity",
        "session": {
            "left": usage_left,
            "reset": reset_at,
            "window": 5 * 60 * 60,
        },
        "weekly": {
            "left": 100.0,
            "reset": now_iso,
            "window": 7 * 24 * 60 * 60,
        },
    }


def bar_width():
    terminal_width = shutil.get_terminal_size(
        fallback=(120, 24)
    ).columns

    return max(
        25,
        min(
            50,
            terminal_width - 50,
        ),
    )


def selected_contexts(context):
    if context == "session":
        return (("Session", "session"),)

    if context == "week":
        return (("Weekly", "weekly"),)

    return (
        ("Session", "session"),
        ("Weekly", "weekly"),
    )


def show_provider(provider, context):
    width = bar_width()

    if USE_COLOR:
        print(
            f"{BOLD}"
            f"{provider['name']}"
            f"{RESET}"
        )
    else:
        print(provider["name"])

    for label, key in selected_contexts(context):
        if key not in provider:
            continue
        limit = provider[key]
        usage_left = limit["left"]

        time_left = time_left_percent(
            limit["reset"],
            limit["window"],
        )

        progress = overlay_bar(
            usage_left,
            time_left,
            width,
        )

        print(
            f"{label:<8}"
            f"{usage_left:3.0f}%  "
            f"{progress}  "
            f"{reset_text(limit['reset'])}"
        )

    print()


def json_limit(limit):
    return {
        "remaining_percent": round(
            limit["left"],
            2,
        ),
        "time_remaining_percent": round(
            time_left_percent(
                limit["reset"],
                limit["window"],
            ),
            2,
        ),
        "reset_at": reset_iso(
            limit["reset"]
        ),
        "reset_in_seconds": reset_seconds(
            limit["reset"]
        ),
        "window_seconds": limit["window"],
    }


def json_provider(provider, context):
    output = {}

    for _, key in selected_contexts(context):
        if key in provider:
            output[key] = json_limit(
                provider[key]
            )

    return output


def selected_fetchers(provider):
    fetchers = {
        "codex": fetch_codex,
        "claude": fetch_claude,
        "antigravity": fetch_antigravity,
        "google": fetch_antigravity,
    }

    if provider:
        return (
            (provider, fetchers[provider]),
        )

    return (
        ("codex", fetch_codex),
        ("claude", fetch_claude),
        ("antigravity", fetch_antigravity),
    )


def main():
    args = parse_arguments()

    providers = {}
    errors = {}

    for provider_id, fetcher in selected_fetchers(
        args.provider
    ):
        try:
            providers[provider_id] = fetcher()

        except Exception as error:
            errors[provider_id] = str(error)

    if args.json:
        output = {
            "generated_at": (
                datetime.now(timezone.utc)
                .isoformat()
                .replace("+00:00", "Z")
            ),
            "providers": {
                provider_id: json_provider(
                    provider,
                    args.context,
                )
                for provider_id, provider in providers.items()
            },
            "errors": errors,
        }

        print(
            json.dumps(
                output,
                separators=(",", ":"),
            )
        )

    else:
        for provider_id, _ in selected_fetchers(
            args.provider
        ):
            provider = providers.get(
                provider_id
            )

            if provider:
                show_provider(
                    provider,
                    args.context,
                )

            elif provider_id in errors:
                print(
                    f"{provider_id.title()}: "
                    f"{errors[provider_id]}",
                    file=sys.stderr,
                )

    raise SystemExit(
        1 if not providers else 0
    )


if __name__ == "__main__":
    main()

