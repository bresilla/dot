#!/usr/bin/env bash
set -euo pipefail

export isaac_sim_package_path="${isaac_sim_package_path:-/opt/isaac}"

export ROS_DISTRO="${ROS_DISTRO:-jazzy}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
# export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Isaac Sim's OmniClient otherwise resolves GitHub's `hub` executable from PATH.
export OMNICLIENT_HUB_MODE="${OMNICLIENT_HUB_MODE:-disabled}"

compat_lib="$isaac_sim_package_path/compat/noble/lib"
if [[ -d "$compat_lib" && ":${LD_LIBRARY_PATH:-}:" != *":$compat_lib:"* ]]; then
    export LD_LIBRARY_PATH="$compat_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

ros_lib="$isaac_sim_package_path/exts/isaacsim.ros2.core/$ROS_DISTRO/lib"
if [[ ":${LD_LIBRARY_PATH:-}:" != *":$ros_lib:"* ]]; then
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$ros_lib"
fi

launcher="$isaac_sim_package_path/isaac-sim.sh"
if [[ "${1:-}" == "--stream" ]]; then
    launcher="$isaac_sim_package_path/isaac-sim.streaming.sh"
    shift
fi

exec "$launcher" --enable isaacsim.ros2.bridge "$@"
