#!/bin/bash

if  [ "$1" == "fzf" ] || [ -z $1 ]; then
    runner=fzy
elif [ "$1" == "rofi" ]; then
    runner=rofit
fi

source $HOME/.cache/wal/colors.sh

path=syspath
font=sysfonts
conf=configs
clip=clipboard
note=notes

another=$(echo "\
$path
$font
$clip
$note
$conf" | $runner)

if [ "$another" == "$conf" ] ; then
    confile=$(find /env/dot/ -type f -not -path "$HOME/dots/.other/*" -not -path "$HOME/dots/.config/Code*" -not -path "$HOME/dots/.config/nvim/plugged/*" | $runner)
    [[ $confile != "" ]] && kitty --class=til nvim $confile

elif [ "$another" == "$path" ] ; then
    echo $PATH | tr ':' '\n' | $runner

elif [ "$another" == "$font" ] ; then
    confile=$(fc-list | $runner)
    fc-query $(echo $confile | cut -d: -f1) | $runner

elif [ "$another" == "$clip" ] ; then
    greenclip print | $runner

elif [ "$another" == "$note" ] ; then
    nnn $HOME/.local/share/notes

else
  exec nohup $another > /dev/null 2>&1 &
fi
