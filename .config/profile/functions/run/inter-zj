#!/usr/bin/env bash
# Zellij version of inter - interactive tools for editor/shell
# Uses zellij actions to send keys back to the original pane

comd=":e"

# @cmd pick file with explorer
# @arg current_path!
# @arg context!
# @arg view!
explorer() {
    local context=$argc_context
    local current_path=$argc_current_path
    local view=$argc_view
    
    if [[ "$context" == "shell" ]]; then
        local tmp_dir="$(mktemp -t "yazi-cwd.XXXXXX")"
        yazi "$current_path" --cwd-file="$tmp_dir" --chooser-file="$tmp_dir"
        if cwd="$(cat -- "$tmp_dir")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
            if [ -f "$cwd" ]; then
                parent_dir=$(dirname "$cwd")
                filetype=$(xdg-mime query filetype "$cwd" | cut -d"/" -f1)
                # Write command to temp file, source pane will pick it up
                echo "cd $parent_dir && $EDITOR $cwd" > /tmp/zellij_inter_cmd
            elif [ -d "$cwd" ]; then
                echo "cd $cwd" > /tmp/zellij_inter_cmd
            fi
        fi
        rm -f -- "$tmp_dir"
    else
        full_name=/tmp/"$view"_"$(basename "$current_path")"_current_file
        pick=$(yazi $(cat "$full_name" 2>/dev/null) --chooser-file=/dev/stdout)
        [[ ! -f "$pick" ]] && exit 0
        echo "$comd $pick" > /tmp/zellij_inter_cmd
    fi
}

# @cmd pick file with finder
# @arg current_path!
# @arg context!
# @arg view!
picker() {
    local context=$argc_context
    local current_path=$argc_current_path
    local view=$argc_view
    
    cd "$current_path"
    pick=$(tv find)
    [[ -z "$pick" ]] && exit 0
    [[ "$pick" == "$current_path" ]] && exit 0
    
    if [[ "$context" == "editor" ]]; then
        echo "$comd $pick" > /tmp/zellij_inter_cmd
    else
        echo "$EDITOR $pick" > /tmp/zellij_inter_cmd
    fi
}

# @cmd find text in file
# @arg current_path!
# @arg context!
# @arg view!
finder() {
    local context=$argc_context
    local current_path=$argc_current_path
    local view=$argc_view
    
    cd "$current_path"
    IFS=':' read -r pick nr < <(tv text)
    [[ -z "$pick" ]] && exit 0
    [[ "$pick" == "$current_path" ]] && exit 0
    
    if [[ "$context" == "editor" ]]; then
        echo "$comd $pick" > /tmp/zellij_inter_cmd
    else
        echo "$EDITOR $pick" > /tmp/zellij_inter_cmd
    fi
}

# @cmd replace text in file
# @arg current_path!
# @arg context!
# @arg view!
replace() {
    local context=$argc_context
    local current_path=$argc_current_path
    local view=$argc_view
    
    serpl -p "$current_path"
}

# @cmd list buffers
# @arg current_path!
# @arg context!
# @arg view!
buffers() {
    local context=$argc_context
    local current_path=$argc_current_path
    local view=$argc_view
    local only_name=$(basename "$current_path")
    
    [[ "$context" != "editor" ]] && exit 
    buffers_list=/tmp/"$view"_"$only_name"_open_buffers
    [[ ! -f "$buffers_list" ]] && exit 0
    pick=$(cat "$buffers_list" | tv --preview 'bat -n --color=always {0}')
    [[ -z "$pick" ]] && exit 0
    echo "$comd $pick" > /tmp/zellij_inter_cmd
}

# @cmd list quickfix
# @arg current_path!
# @arg context!
# @arg view!
quickfix() {
    local context=$argc_context
    local current_path=$argc_current_path
    local view=$argc_view
    
    quickfix_list=$current_path/.quickfix
    [[ ! -f "$quickfix_list" ]] && exit 0
    pick=$(cat "$quickfix_list" | tv)
    file=$(echo "$pick" | cut -d: -f1)
    line=$(echo "$pick" | cut -d: -f2)
    col=$(echo "$pick" | cut -d: -f3)
    
    [[ -z "$file" ]] && exit 0
    # For editor, send commands to open file and go to line
    echo ":e $file|:cal cursor($line, $col)" > /tmp/zellij_inter_cmd
}

eval "$(argc --argc-eval "$0" "$@")"
