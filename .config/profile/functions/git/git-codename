#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: $0 <changelog-text | changelog-file>" >&2
  exit 1
fi

if [ -f "$1" ]; then
  CHANGELOG="$(cat "$1")"
else
  CHANGELOG="$1"
fi

echo "$(
  aichat "Based on the following changelog, generate ONLY ONE creative release codename.
Exactly two words. Poetic or evocative.
No emojis. No punctuation. Output ONLY the two words.

Changelog:
$CHANGELOG" \
  | head -n 1 \
  | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
)"

