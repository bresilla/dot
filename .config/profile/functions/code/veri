#!/usr/bin/env bash

set -euo pipefail

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE_BOLD='\033[1;34m'
NC='\033[0m' # No Color

find_project_dir() {
    local dir="$PWD"

    if command -v git >/dev/null 2>&1 && git rev-parse --show-toplevel >/dev/null 2>&1; then
        git rev-parse --show-toplevel
        return
    fi

    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/Cargo.toml" || -f "$dir/build.zig.zon" || -f "$dir/xmake.lua" \
            || -f "$dir/package.json" || -f "$dir/pyproject.toml" || -f "$dir/flake.nix" \
            || -n "$(find "$dir" -maxdepth 1 -name '*.nimble' -type f -print -quit)" ]]; then
            printf '%s\n' "$dir"
            return
        fi
        dir="$(dirname "$dir")"
    done

    printf '%s\n' "$PWD"
}

extract_first_match() {
    local file="$1"
    local regex="$2"

    sed -nE "s/$regex/\\1/p" "$file" | head -1
}

# go_version_file echoes the path to the Go source file holding the app version
# string (a `version = "X.Y.Z"` declaration), preferring common entrypoints.
go_version_file() {
    local project_dir="$1"
    local re='(^|[[:space:]])((const|var)[[:space:]]+)?[vV]ersion[[:space:]]*=[[:space:]]*"[0-9]+\.[0-9]+\.[0-9]+"'
    local cand
    for cand in main.go src/main.go version.go internal/version/version.go cmd/version.go; do
        if [[ -f "$project_dir/$cand" ]] && grep -qE "$re" "$project_dir/$cand"; then
            printf '%s\n' "$project_dir/$cand"
            return 0
        fi
    done
    grep -rElE "$re" --include='*.go' "$project_dir" 2>/dev/null | head -1 || true
}

nix_package_file() {
    local project_dir="$1"
    local file="$project_dir/nix/package.nix"

    [[ -f "$file" ]] || return 0
    grep -qE '^[[:space:]]*version[[:space:]]*=[[:space:]]*"[0-9]+\.[0-9]+\.[0-9]+"[[:space:]]*;' "$file" || return 0
    printf '%s\n' "$file"
}

nimble_file() {
    local project_dir="$1"
    find "$project_dir" -maxdepth 1 -name '*.nimble' -type f | sort | head -1
}

nim_version_file() {
    local project_dir="$1"
    local re='(^|[[:space:]])[vV]ersion[[:space:]]*=[[:space:]]*"[0-9]+\.[0-9]+\.[0-9]+"'
    local cand
    for cand in src/"$(basename "$project_dir")".nim src/main.nim src/dp.nim main.nim version.nim; do
        if [[ -f "$project_dir/$cand" ]] && grep -qE "$re" "$project_dir/$cand"; then
            printf '%s\n' "$project_dir/$cand"
            return 0
        fi
    done
    grep -rElE "$re" --include='*.nim' "$project_dir" 2>/dev/null | head -1 || true
}

project_name() {
    local project_dir="$1"
    local value=""

    if [[ -f "$project_dir/Cargo.toml" ]]; then
        value="$(extract_first_match "$project_dir/Cargo.toml" '^[[:space:]]*name[[:space:]]*=[[:space:]]*"([^"]+)".*')"
    fi

    if [[ -z "$value" && -f "$project_dir/go.mod" ]]; then
        value="$(basename "$(sed -n 's/^module[[:space:]]*//p' "$project_dir/go.mod" | head -1)")"
    fi

    if [[ -z "$value" ]]; then
        local nixpkg
        nixpkg="$(nix_package_file "$project_dir")"
        if [[ -n "$nixpkg" ]]; then
            value="$(extract_first_match "$nixpkg" '^[[:space:]]*pname[[:space:]]*=[[:space:]]*"([^"]+)".*')"
        fi
    fi

    if [[ -z "$value" && -f "$project_dir/package.json" ]]; then
        value="$(extract_first_match "$project_dir/package.json" '^[[:space:]]*"name"[[:space:]]*:[[:space:]]*"([^"]+)".*')"
    fi

    if [[ -z "$value" && -f "$project_dir/pyproject.toml" ]]; then
        value="$(extract_first_match "$project_dir/pyproject.toml" '^[[:space:]]*name[[:space:]]*=[[:space:]]*"([^"]+)".*')"
    fi

    if [[ -z "$value" ]]; then
        local nimble
        nimble="$(nimble_file "$project_dir")"
        if [[ -n "$nimble" ]]; then
            value="$(basename "$nimble" .nimble)"
        fi
    fi

    if [[ -z "$value" ]]; then
        value="$(basename "$project_dir")"
    fi

    printf '%s\n' "$value"
}

project_version() {
    local project_dir="$1"
    local value=""

    if [[ -f "$project_dir/Cargo.toml" ]]; then
        value="$(extract_first_match "$project_dir/Cargo.toml" '^[[:space:]]*version[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*')"
    fi

    if [[ -z "$value" && -f "$project_dir/go.mod" ]]; then
        local gofile
        gofile="$(go_version_file "$project_dir")"
        if [[ -n "$gofile" ]]; then
            value="$(extract_first_match "$gofile" '^[[:space:]]*.*[vV]ersion[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*')"
        fi
    fi

    if [[ -z "$value" && -f "$project_dir/build.zig.zon" ]]; then
        value="$(extract_first_match "$project_dir/build.zig.zon" '^[[:space:]]*\.version[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*')"
    fi

    if [[ -z "$value" ]]; then
        local nixpkg
        nixpkg="$(nix_package_file "$project_dir")"
        if [[ -n "$nixpkg" ]]; then
            value="$(extract_first_match "$nixpkg" '^[[:space:]]*version[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*')"
        fi
    fi

    if [[ -z "$value" && -f "$project_dir/xmake.lua" ]]; then
        value="$(extract_first_match "$project_dir/xmake.lua" '^[[:space:]]*local[[:space:]]+PROJECT_VERSION[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*')"
    fi

    if [[ -z "$value" && -f "$project_dir/package.json" ]]; then
        value="$(extract_first_match "$project_dir/package.json" '^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*')"
    fi

    if [[ -z "$value" && -f "$project_dir/pyproject.toml" ]]; then
        value="$(extract_first_match "$project_dir/pyproject.toml" '^[[:space:]]*version[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*')"
    fi

    if [[ -z "$value" ]]; then
        local nimble
        nimble="$(nimble_file "$project_dir")"
        if [[ -n "$nimble" ]]; then
            value="$(extract_first_match "$nimble" '^[[:space:]]*version[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*')"
        fi
    fi

    [[ -n "$value" ]] || return 1
    printf '%s\n' "$value"
}

update_go() {
    local project_dir="$1"
    local version="$2"
    [[ -f "$project_dir/go.mod" ]] || return 0
    local gofile
    gofile="$(go_version_file "$project_dir")"
    [[ -n "$gofile" ]] || return 0
    sed -i -E "s/^([[:space:]]*((const|var)[[:space:]]+)?[vV]ersion[[:space:]]*=[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$gofile"
    echo "  Updated ${gofile#$project_dir/}"
}

update_nix_package() {
    local project_dir="$1"
    local version="$2"
    local file
    file="$(nix_package_file "$project_dir")"
    [[ -n "$file" ]] || return 0
    sed -i -E "s/^([[:space:]]*version[[:space:]]*=[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$file"
    echo "  Updated ${file#$project_dir/}"
}

update_zig() {
    local project_dir="$1"
    local version="$2"
    local file="$project_dir/build.zig.zon"
    [[ -f "$file" ]] || return 0
    sed -i -E "s/(\.version[[:space:]]*=[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$file"
    echo "  Updated build.zig.zon"
}

update_xmake() {
    local project_dir="$1"
    local version="$2"
    local file="$project_dir/xmake.lua"
    [[ -f "$file" ]] || return 0
    sed -i -E "s/(local[[:space:]]+PROJECT_VERSION[[:space:]]*=[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$file"
    echo "  Updated xmake.lua"
}

update_cargo() {
    local project_dir="$1"
    local version="$2"
    local file="$project_dir/Cargo.toml"
    [[ -f "$file" ]] || return 0
    sed -i -E "s/^(version[[:space:]]*=[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$file"
    echo "  Updated Cargo.toml"
}

update_package_json() {
    local project_dir="$1"
    local version="$2"
    local file="$project_dir/package.json"
    [[ -f "$file" ]] || return 0
    sed -i -E "s/^([[:space:]]*\"version\"[[:space:]]*:[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$file"
    echo "  Updated package.json"
}

update_pyproject() {
    local project_dir="$1"
    local version="$2"
    local file="$project_dir/pyproject.toml"
    [[ -f "$file" ]] || return 0
    sed -i -E "s/^(version[[:space:]]*=[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$file"
    echo "  Updated pyproject.toml"
}

update_nimble() {
    local project_dir="$1"
    local version="$2"
    local file
    file="$(nimble_file "$project_dir")"
    [[ -n "$file" ]] || return 0
    sed -i -E "s/^([[:space:]]*version[[:space:]]*=[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$file"
    echo "  Updated ${file#$project_dir/}"
}

update_nim() {
    local project_dir="$1"
    local version="$2"
    local file
    file="$(nim_version_file "$project_dir")"
    [[ -n "$file" ]] || return 0
    sed -i -E "s/^([[:space:]]*[vV]ersion[[:space:]]*=[[:space:]]*)\"[0-9]+\.[0-9]+\.[0-9]+\"/\1\"$version\"/" "$file"
    echo "  Updated ${file#$project_dir/}"
}

main() {
    local project_dir
    project_dir="$(find_project_dir)"

    local name
    name="$(project_name "$project_dir")"

    local current_version
    if ! current_version="$(project_version "$project_dir")"; then
        echo -e "Updating ${BLUE_BOLD}$name${NC} version: ${RED}[ FAILED: no supported version file found ]${NC}"
        return 1
    fi

    # No arguments - just show version
    if [[ $# -eq 0 ]]; then
        echo "$current_version"
        return 0
    fi

    local arg="$1"
    local version

    case "$arg" in
        patch|minor|major)
            IFS='.' read -r major minor patch <<< "$current_version"
            case "$arg" in
                major) major=$((major+1)); minor=0; patch=0 ;;
                minor) minor=$((minor+1)); patch=0 ;;
                patch) patch=$((patch+1)) ;;
            esac
            version="$major.$minor.$patch"
            ;;
        *)
            if [[ ! "$arg" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                echo -e "Updating ${BLUE_BOLD}$name${NC} version: ${RED}[ FAILED: invalid version format ]${NC}"
                return 1
            fi
            version="$arg"
            ;;
    esac

    update_go "$project_dir" "$version"
    update_nix_package "$project_dir" "$version"
    update_zig "$project_dir" "$version"
    update_xmake "$project_dir" "$version"
    update_cargo "$project_dir" "$version"
    update_package_json "$project_dir" "$version"
    update_pyproject "$project_dir" "$version"
    update_nimble "$project_dir" "$version"
    update_nim "$project_dir" "$version"

    echo -e "Updating ${BLUE_BOLD}$name${NC} version: $current_version -> $version ${GREEN}[ SUCCESS ]${NC}"
}

main "$@"
