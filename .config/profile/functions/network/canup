#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: canup <iface> [vcan|vcanfd]"
    exit 1
fi

iface="$1"
type="${2:-vcan}"

# Load the correct kernel module if needed
if ! lsmod | grep -q "^${type}"; then
    modprobe "$type"
fi

# Create the interface only if it does not already exist
if ip link show "$iface" &>/dev/null; then
    echo "Interface $iface already exists"
else
    ip link add dev "$iface" type "$type"
    echo "Created $type interface: $iface"
fi

# Bring up the interface
ip link set dev "$iface" up
echo "Interface $iface is up"
