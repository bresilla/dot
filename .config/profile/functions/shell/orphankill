#!/usr/bin/env bash
#
# orphankill - find and kill orphaned leftover processes from test/build runs
#
# Targets processes that are ALL of:
#   1. owned by the current user      (never root / never system daemons)
#   2. re-parented to init (PPID 1)   (their launcher died, nothing reaped them)
#   3. sitting in a DELETED cwd       (their scratch dir was already cleaned up)
#   4. under a temp root              (/tmp, /var/tmp, $HOME/data/tmp, ...)
#   5. older than --age minutes       (never touch a run still in progress)
#
# Anything failing even one test is left alone. Kernel threads, PID 1, our own
# ancestry, and a deny-list of session-critical processes are hard-excluded.

set -uo pipefail

ME=$(id -u)
AGE_MIN=60
ASSUME_YES=0
DRY_RUN=0
VERBOSE=0
PATTERN=""
declare -a ROOTS=()

# processes that must never be touched even if they somehow match
DENY='^(systemd|systemd-.*|dbus-daemon|dbus-broker|pipewire|pipewire-pulse|wireplumber|pulseaudio|Xorg|Xwayland|Hyprland|sway|gnome-shell|plasmashell|sshd|login|agetty|init|dockerd|containerd|gpg-agent|ssh-agent|keyboxd|polkitd)$'

usage() {
    cat <<'EOF'
orphankill - kill orphaned leftover processes from test/build runs

usage: orphankill [options]

options:
  -y, --yes            kill without the confirmation prompt
  -n, --dry-run        only list what would be killed, never kill
  -a, --age MIN        minimum process age in minutes (default: 60)
  -p, --pattern STR    only match if cwd contains STR (e.g. hexe-smoke)
  -r, --root DIR       add a temp root to scan (repeatable)
  -v, --verbose        show why non-matching orphans were skipped
  -h, --help           this help

default temp roots:
  /tmp  /var/tmp  /dev/shm  $TMPDIR  $HOME/data/tmp  $HOME/tmp

examples:
  orphankill                        # scan, list, ask before killing
  orphankill -n                     # dry run only
  orphankill -p hexe-smoke -y       # kill hexe smoke-test leftovers, no prompt
  orphankill -a 5                   # anything orphaned for over 5 minutes
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes)     ASSUME_YES=1; shift ;;
        -n|--dry-run) DRY_RUN=1; shift ;;
        -a|--age)     AGE_MIN="${2:-}"; shift 2 ;;
        -p|--pattern) PATTERN="${2:-}"; shift 2 ;;
        -r|--root)    ROOTS+=("${2:-}"); shift 2 ;;
        -v|--verbose) VERBOSE=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        *) echo "orphankill: unknown option '$1'" >&2; usage >&2; exit 2 ;;
    esac
done

if ! [[ "$AGE_MIN" =~ ^[0-9]+$ ]]; then
    echo "orphankill: --age must be a whole number of minutes" >&2
    exit 2
fi
AGE_SEC=$((AGE_MIN * 60))

# default temp roots, plus any the user added
if [[ ${#ROOTS[@]} -eq 0 ]]; then
    ROOTS=(/tmp /var/tmp /dev/shm "$HOME/data/tmp" "$HOME/tmp")
    [[ -n "${TMPDIR:-}" ]] && ROOTS+=("${TMPDIR%/}")
fi

# our own ancestry - killing any of these would take down this shell
declare -A SELF=()
_p=$$
while [[ -n "$_p" && "$_p" != "0" && "$_p" != "1" ]]; do
    SELF[$_p]=1
    _p=$(awk '/^PPid:/{print $2}' "/proc/$_p/status" 2>/dev/null)
done

under_root() {
    local path="$1" r
    for r in "${ROOTS[@]}"; do
        [[ -n "$r" && "$path" == "$r"/* ]] && return 0
    done
    return 1
}

skip() { [[ $VERBOSE -eq 1 ]] && printf '  skip %-8s %s\n' "$1" "$2" >&2; }

declare -a TARGETS=()

for pdir in /proc/[0-9]*; do
    pid=${pdir#/proc/}

    [[ "$pid" == "1" ]] && continue
    [[ -n "${SELF[$pid]:-}" ]] && continue
    [[ -r "$pdir/status" ]] || continue

    # own uid only - this is what keeps root/system processes out
    uid=$(awk '/^Uid:/{print $2; exit}' "$pdir/status" 2>/dev/null)
    [[ "$uid" == "$ME" ]] || continue

    # orphaned only
    ppid=$(awk '/^PPid:/{print $2; exit}' "$pdir/status" 2>/dev/null)
    [[ "$ppid" == "1" ]] || continue

    comm=$(<"$pdir/comm") 2>/dev/null || continue
    [[ "$comm" =~ $DENY ]] && { skip deny "$pid $comm"; continue; }

    # kernel threads have no readable cwd
    cwd=$(readlink "$pdir/cwd" 2>/dev/null) || continue
    [[ -n "$cwd" ]] || continue

    # the scratch dir must already be gone
    [[ "$cwd" == *" (deleted)" ]] || { skip live-cwd "$pid $comm"; continue; }
    bare=${cwd% (deleted)}

    under_root "$bare" || { skip not-tmp "$pid $bare"; continue; }

    if [[ -n "$PATTERN" && "$bare" != *"$PATTERN"* ]]; then
        skip pattern "$pid $bare"; continue
    fi

    age=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
    [[ -n "$age" ]] || continue
    if [[ "$age" -lt "$AGE_SEC" ]]; then
        skip too-new "$pid ${age}s"; continue
    fi

    TARGETS+=("$pid")
done

if [[ ${#TARGETS[@]} -eq 0 ]]; then
    echo "orphankill: no orphaned processes matched - nothing to do"
    exit 0
fi

# collect full subtrees so children do not just re-orphan
declare -a ALL=()
collect() {
    local p=$1 c
    ALL+=("$p")
    for c in $(pgrep -P "$p" 2>/dev/null); do
        [[ -n "${SELF[$c]:-}" ]] && continue
        collect "$c"
    done
}
for p in "${TARGETS[@]}"; do collect "$p"; done

printf 'orphankill: %d orphaned process(es), %d including children\n\n' \
    "${#TARGETS[@]}" "${#ALL[@]}"

printf '  %-8s %-16s %-10s %s\n' PID COMMAND AGE CWD
for p in "${TARGETS[@]}"; do
    printf '  %-8s %-16s %-10s %s\n' \
        "$p" \
        "$(cat "/proc/$p/comm" 2>/dev/null)" \
        "$(ps -o etime= -p "$p" 2>/dev/null | tr -d ' ')" \
        "$(readlink "/proc/$p/cwd" 2>/dev/null)"
done

cputime=0
for p in "${ALL[@]}"; do
    t=$(ps -o cputimes= -p "$p" 2>/dev/null | tr -d ' ')
    [[ -n "$t" ]] && cputime=$((cputime + t))
done
printf '\n  cumulative CPU burned: %dh %dm\n\n' $((cputime / 3600)) $(((cputime % 3600) / 60))

if [[ $DRY_RUN -eq 1 ]]; then
    echo "orphankill: dry run, nothing killed"
    exit 0
fi

if [[ $ASSUME_YES -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
        echo "orphankill: not a terminal, refusing to kill without --yes" >&2
        exit 1
    fi
    read -r -p "kill these ${#ALL[@]} process(es)? [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "orphankill: aborted"; exit 1; }
fi

# parents first so the fork loops stop before we sweep the children
killed=0
for p in "${TARGETS[@]}"; do
    kill -9 "$p" 2>/dev/null && killed=$((killed + 1))
done
for p in "${ALL[@]}"; do
    kill -9 "$p" 2>/dev/null
done

sleep 1
survivors=0
for p in "${ALL[@]}"; do
    [[ -d "/proc/$p" ]] && survivors=$((survivors + 1))
done

printf 'orphankill: killed %d orphan(s)' "$killed"
if [[ $survivors -gt 0 ]]; then
    printf ', %d still present (likely stuck in D state, retry shortly)\n' "$survivors"
    exit 1
fi
printf ', all clear\n'
