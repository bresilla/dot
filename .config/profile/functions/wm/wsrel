# /env/dot/.func/wm/wsrel
#!/usr/bin/env bash
set -euo pipefail

A="${1:-}"; shift || true
case "${A}" in
  go-next|go-prev|move-next|move-prev) ;;
  *) echo "usage: wsrel {go-next|go-prev|move-next|move-prev}" >&2; exit 1 ;;
esac

OUTS_JSON="$(swaymsg -t get_outputs)"
WSS_JSON="$(swaymsg -t get_workspaces)"

FOC_OUT="$(jq -r '.[] | select(.focused==true) | .name' <<<"$OUTS_JSON")"
if [ -z "$FOC_OUT" ] || [ "$FOC_OUT" = "null" ]; then
  echo "no focused output" >&2; exit 2
fi

ORDERED_OUTS="$(jq -r 'sort_by(.rect.x) | .[].name' <<<"$OUTS_JSON")"

RANGE_START=1
RANGE_END=10
IDX=0
while read -r N; do
  if [ "$N" = "$FOC_OUT" ]; then
    RANGE_START=$((IDX*10+1))
    RANGE_END=$((IDX*10+10))
    break
  fi
  IDX=$((IDX+1))
done <<<"$ORDERED_OUTS"

CUR_WS_NAME="$(jq -r '.[] | select(.focused==true) | .name' <<<"$WSS_JSON")"
CUR_WS_NUM="$(awk 'match($0,/^[0-9]+/){print substr($0,RSTART,RLENGTH)}' <<<"$CUR_WS_NAME")"
if [ -z "$CUR_WS_NUM" ] || [ "$CUR_WS_NUM" -lt "$RANGE_START" ] || [ "$CUR_WS_NUM" -gt "$RANGE_END" ]; then
  CUR_WS_NUM="$RANGE_START"
fi

next_ws="$CUR_WS_NUM"
prev_ws="$CUR_WS_NUM"

if [ "$CUR_WS_NUM" -lt "$RANGE_END" ]; then next_ws=$((CUR_WS_NUM+1)); else next_ws="$RANGE_START"; fi
if [ "$CUR_WS_NUM" -gt "$RANGE_START" ]; then prev_ws=$((CUR_WS_NUM-1)); else prev_ws="$RANGE_END"; fi

ensure_on_output() {
  local num="$1"
  swaymsg "workspace number $num, move workspace to output $FOC_OUT" >/dev/null
}

case "$A" in
  go-next)
    ensure_on_output "$next_ws"
    swaymsg "workspace number $next_ws" >/dev/null
    ;;
  go-prev)
    ensure_on_output "$prev_ws"
    swaymsg "workspace number $prev_ws" >/dev/null
    ;;
  move-next)
    ensure_on_output "$next_ws"
    swaymsg "move container to workspace number $next_ws; workspace number $next_ws" >/dev/null
    ;;
  move-prev)
    ensure_on_output "$prev_ws"
    swaymsg "move container to workspace number $prev_ws; workspace number $prev_ws" >/dev/null
    ;;
esac
