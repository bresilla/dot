cabal-version:      2.4
name:               {{kebab_name}}
version:            0.1.0
synopsis:           {{PROJECT_NAME}}
license:            MIT
build-type:         Simple

library
    exposed-modules:  {{PascalName}}
    hs-source-dirs:   src
    build-depends:    base >=4 && <5
    default-language: Haskell2010
    ghc-options:      -Wall

executable {{kebab_name}}
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base >=4 && <5, {{kebab_name}}
    default-language: Haskell2010
    ghc-options:      -Wall

test-suite {{kebab_name}}-test
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base >=4 && <5, {{kebab_name}}
    default-language: Haskell2010
    ghc-options:      -Wall
