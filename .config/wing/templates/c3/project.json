{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [ "no-unused" ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [ "lib" ],
  "dependencies": [ ],
  "authors": [ "you <you@example.com>" ],
  // Version using semantic versioning.
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  "output": "build",
  "targets": {
    "{{kebab_name}}": {
      "type": "executable"
    }
  }
}
