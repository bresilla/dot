[core]
    pager = delta --dark
    quotepath = false
    commitGraph = true
    excludesFile = ~/.config/git/ignore

[credential]
    helper = cache

[color]
    ui = true
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = yellow
    changed = green
    untracked = red

[push]
    default = simple
[pull]
    rebase = true
[rebase]
    autostash = true

[merge]
    log = true
    ff = false
    tool = diffconflicts
[mergetool "diffconflicts"]
    cmd = nvim -c DiffConflicts \"$MERGED\" \"$BASE\" \"$LOCAL\" \"$REMOTE\"
    trustExitCode = true
[mergetool]
    keepBackup = false

[alias]
    [alias]
    ai = "!git aic"
    view = !grv
    ban = "!fd -E ".git" -H . | fzf | parallel 'git ignore {}; git rm -rf --cached {};'"
    uncommit = reset --soft HEAD^
    master = "!git checkout master || git checkout main"
    main = "!git checkout main || git checkout master"
    develop = checkout develop
    hub = "!f(){ gh $@; }; f"
    module = submodule
    check = checkout
    clone = clone --recursive
    pubone = "!f(){ git push ${1:-origin} --follow-tags; }; f"
    #pub = "!f(){ for line in $(git remote -v | cut -f1 | sort -u); do git push $line --all --follow-tags; done; }; f"
    fuse = "!f(){ target=\"$1\"; [ -n \"$target\" ] || { echo 'usage: git fuse <target-branch>'; return 2; }; source_branch=$(git symbolic-ref --quiet --short HEAD) || { echo 'error: detached HEAD'; return 2; }; [ \"$source_branch\" != \"$target\" ] || { echo \"error: source and target are the same: $target\"; return 2; }; git rev-parse --verify --quiet \"refs/heads/$target\" >/dev/null || { echo \"error: local branch not found: $target\"; return 2; }; if ! git diff --quiet || ! git diff --cached --quiet; then echo 'error: working tree not clean'; return 2; fi; git switch \"$target\" || return $?; git merge -m \"chore: merge $source_branch to $target\" \"$source_branch\"; merge_rc=$?; if [ $merge_rc -eq 0 ]; then git up; up_rc=$?; git switch \"$source_branch\" >/dev/null || true; return $up_rc; fi; return $merge_rc; }; f"
    ; get = "!f(){ INPUT=${1:-$(xsel --clipboard)}; NAMEEE=$(echo $INPUT | cut -d/ -f1-5); git clone --recursive $NAMEEE; }; f"
    down = "!f(){ INPUT=${1:-$(xsel --clipboard)}; NAMEEE=$(echo $INPUT | cut -d/ -f1-5); git clone --recursive $NAMEEE -- /home/$USER/down/$(echo $NAMEEE | cut -d/ -f5); }; f"
    fuck = "!f(){ git reset --hard origin/`git rev-parse --abbrev-ref HEAD`; rm -fv `git status | grep ^? | cut -d' '  -f2-`; }; f"
    tree = log --graph --all --format=format:'%w(80,0,0)%C(bold magenta)%h%C(reset) %C(white)%ad%C(reset) %C(dim white)(%ar)%C(reset) %C(bold dim white)%aN%C(auto)%+D%C(reset)%n%C(bold white)%s%C(reset)%n'
    atree = log --graph --all --format=format:'%w(80,0,0)%C(bold magenta)%h%C(reset) %C(white)%ad%C(reset) %C(dim white)(%ar)%C(reset) %C(bold dim white)%aN%C(auto)%+D%C(reset)%n%C(bold white)%s%C(reset)%+b%n'
    open = "!f(){ hub browse; }; f"
    remotes = remote -v
    branches = branch -a
    conflicts = !git diff --name-only --diff-filter=U
    fix = !git mergetool --tool=diffconflicts
    root = rev-parse --show-toplevel
    ignore = "!f(){ echo $@ >> .gitignore; }; f"
    up = "!f(){ git remotes | grep push | cut -f1 | xargs -I{} git push --all -u {}; }; f"
    go = "!f(){ git commit && git up; }; f"
    start = "!f(){ git flow feature start ${1:-feature}; }; f"
    finish = "!f(){ git flow feature finish; }; f"
    rmtag = "!f() { git tag -d \"$1\" && git push origin \":refs/tags/$1\"; }; f"
    sshify = "!f(){ \
        url=$(git remote get-url origin 2>/dev/null) || exit; \
        case \"$url\" in \
          https://github.com/*) \
            path=${url#https://github.com/}; \
            path=${path%.git}; \
            git remote set-url origin git@github.com:${path}.git ;; \
          git@github.com:*) \
            echo 'origin already uses SSH: '$url ;; \
          *) \
            echo 'not a GitHub https remote: '$url ;; \
        esac; \
    }; f"
[gc]
    writeCommitGraph = true
; [commit]
    ; gpgSign = true
