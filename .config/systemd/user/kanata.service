[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin
Environment=DISPLAY=:0
Environment=HOME=%h
Type=simple
ExecStart=%h/.local/bin/kanata --cfg %h/.config/kanata/minial.kbd
Restart=no

[Install]
WantedBy=default.target
