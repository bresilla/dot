[Unit]
Description=QuickShell component (%i)
PartOf=quickshell.target
StartLimitIntervalSec=30
StartLimitBurst=5

# Hyprland is not launched through graphical-session.target here, so ordering
# against it never waits for anything. Refuse to start until the session
# environment has been imported -- without WAYLAND_DISPLAY, Qt falls back to xcb
# and aborts, burning the restart limit before Hyprland is even up.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=%h/.config/quickshell/launch.sh run %i
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=quickshell.target
